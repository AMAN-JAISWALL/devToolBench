---
import Layout from '../layouts/Layout.astro';

const fields = [
  { key: 'fullName', label: 'Full Name' },
  { key: 'email', label: 'Email' },
  { key: 'phone', label: 'Phone' },
  { key: 'street', label: 'Street Address' },
  { key: 'city', label: 'City' },
  { key: 'country', label: 'Country' },
  { key: 'company', label: 'Company' },
  { key: 'jobTitle', label: 'Job Title' },
  { key: 'uuid', label: 'UUID' },
  { key: 'date', label: 'Date' },
  { key: 'boolean', label: 'Boolean' },
  { key: 'avatar', label: 'Avatar URL' },
  { key: 'price', label: 'Price' },
  { key: 'lorem', label: 'Lorem Paragraph' },
];
const defaults = ['fullName', 'email', 'city', 'company'];
---

<Layout
  title="Free Fake Data Generator — Mock JSON, CSV & SQL Test Data"
  description="Free fake data generator: create up to 1,000 rows of realistic mock data — names, emails, addresses, companies, UUIDs — as JSON, CSV, or SQL INSERTs. Online test data generator, 100% in your browser. Free Mockaroo alternative."
  keywords={[
    'fake data generator',
    'mock data generator',
    'test data generator',
    'mock json data generator',
    'dummy data generator',
    'fake name and email generator',
    'csv mock data',
    'sql insert generator',
    'mockaroo alternative',
  ]}
  path="/fake-data-generator"
>
  <section class="intro">
    <h1>Fake Data Generator — Mock JSON, CSV &amp; SQL</h1>
    <p>
      Mock data for testing, demos, and seeding databases. Everything runs locally in your
      browser — nothing you configure or generate is ever sent anywhere. A free alternative
      to Mockaroo: no row caps behind a paywall, no sign-up, up to 1,000 rows per export.
    </p>
  </section>

  <section class="tool">
    <div class="controls">
      <fieldset class="fields">
        <legend>Fields (column order = output order)</legend>
        <div class="checkbox-grid">
          {fields.map((f) => (
            <label class="check">
              <input type="checkbox" name="field" value={f.key} checked={defaults.includes(f.key)} />
              <span>{f.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="panel">
        <label class="field-label" for="row-count">Rows (1–1000)</label>
        <input id="row-count" type="number" min="1" max="1000" value="10" />

        <fieldset>
          <legend>Output format</legend>
          <div class="format-toggle" role="radiogroup" aria-label="Output format">
            <label class="check"><input type="radio" name="format" value="json" checked /><span>JSON</span></label>
            <label class="check"><input type="radio" name="format" value="csv" /><span>CSV</span></label>
            <label class="check"><input type="radio" name="format" value="sql" /><span>SQL</span></label>
          </div>
        </fieldset>

        <div id="table-name-wrap" class="hidden">
          <label class="field-label" for="table-name">SQL table name</label>
          <input id="table-name" type="text" value="users" class="mono" />
        </div>

        <div class="actions">
          <button id="copy-btn" type="button">Copy</button>
          <button id="download-btn" type="button" class="primary">Download</button>
        </div>
      </div>
    </div>

    <div class="preview-block">
      <p class="preview-label mono">Live preview (first 10 rows)</p>
      <pre id="preview" class="mono" aria-live="polite"></pre>
    </div>
  </section>

  <!-- Ad slot: in-content — paste your AdSense unit here after approval -->
  <div class="ad-slot" data-ad-slot="in-content"></div>

  <section class="explainer">
    <h2>Why use fake data?</h2>
    <p>
      Real user data in development environments is a liability — it leaks during debugging,
      ends up in screenshots and bug reports, and complicates GDPR compliance. Generating
      realistic mock data lets you develop and demo against data that looks and behaves like
      production without exposing anyone. Use it to seed databases, populate UI prototypes,
      stress-test forms and imports, or fill spreadsheets for training material.
    </p>
    <p>
      This generator produces data entirely in your browser using
      <a href="https://fakerjs.dev" rel="noopener">Faker</a>, an MIT-licensed open-source
      library bundled at build time. There is no API call, no rate limit, and no server
      seeing your configuration — unlike hosted services, it works offline once the page is
      loaded.
    </p>

    <h2>FAQ</h2>
    <div class="faq">
      <details>
        <summary>What's the maximum number of rows?</summary>
        <p>
          1,000 per export. Larger generated datasets in a browser tab can freeze the page,
          so bigger exports are deliberately a later feature, not v1. You can run multiple
          exports in the meantime.
        </p>
      </details>
      <details>
        <summary>Which export format should I pick?</summary>
        <p>
          <strong>JSON</strong> for APIs and JavaScript, <strong>CSV</strong> for
          spreadsheets and bulk imports, <strong>SQL</strong> for direct INSERT statements —
          set your table name and column keys map directly to your chosen fields.
        </p>
      </details>
      <details>
        <summary>Is any of this data sent to a server?</summary>
        <p>
          No. Generation happens locally with a bundled library; there are zero network
          requests. The Copy and Download buttons also work entirely client-side.
        </p>
      </details>
      <details>
        <summary>How is this different from Mockaroo?</summary>
        <p>
          Mockaroo is great but paywalls larger datasets and extra fields. This tool is free
          with no account: all 14 field types and the full 1,000 rows are available to
          everyone, every time.
        </p>
      </details>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: "What's the maximum number of rows?",
        acceptedAnswer: { '@type': 'Answer', text: '1,000 per export. Larger generated datasets in a browser tab can freeze the page, so bigger exports are deliberately a later feature. You can run multiple exports in the meantime.' },
      },
      {
        '@type': 'Question',
        name: 'Which export format should I pick?',
        acceptedAnswer: { '@type': 'Answer', text: 'JSON for APIs and JavaScript, CSV for spreadsheets and bulk imports, SQL for direct INSERT statements with your own table name.' },
      },
      {
        '@type': 'Question',
        name: 'Is any of this data sent to a server?',
        acceptedAnswer: { '@type': 'Answer', text: 'No. Generation happens locally in your browser with a bundled open-source library; there are zero network requests.' },
      },
      {
        '@type': 'Question',
        name: 'How is this different from Mockaroo?',
        acceptedAnswer: { '@type': 'Answer', text: 'Mockaroo paywalls larger datasets and extra fields. This tool is free with no account: all 14 field types and the full 1,000 rows are available to everyone.' },
      },
    ],
  })} />

  <script>
    import { faker } from '@faker-js/faker';

    const FIELD_LABELS: Record<string, string> = {
      fullName: 'full_name', email: 'email', phone: 'phone', street: 'street_address',
      city: 'city', country: 'country', company: 'company', jobTitle: 'job_title',
      uuid: 'uuid', date: 'date', boolean: 'boolean', avatar: 'avatar_url',
      price: 'price', lorem: 'lorem',
    };

    const generators: Record<string, () => unknown> = {
      fullName: () => faker.person.fullName(),
      email: () => faker.internet.email(),
      phone: () => faker.phone.number(),
      street: () => faker.location.streetAddress(),
      city: () => faker.location.city(),
      country: () => faker.location.country(),
      company: () => faker.company.name(),
      jobTitle: () => faker.person.jobTitle(),
      uuid: () => faker.string.uuid(),
      date: () => faker.date.recent({ days: 365 }).toISOString().slice(0, 10),
      boolean: () => faker.datatype.boolean(),
      avatar: () => faker.image.avatar(),
      price: () => faker.commerce.price({ min: 1, max: 999, dec: 2 }),
      lorem: () => faker.lorem.paragraph(),
    };

    const container = document.querySelector('main')!;
    const previewEl = document.getElementById('preview')!;
    const rowCountInput = document.getElementById('row-count') as HTMLInputElement;
    const tableNameInput = document.getElementById('table-name') as HTMLInputElement;
    const tableNameWrap = document.getElementById('table-name-wrap')!;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;

    function selectedFields(): string[] {
      return Array.from(container.querySelectorAll<HTMLInputElement>('input[name="field"]:checked'))
        .map((el) => el.value)
        .filter((k) => k in generators);
    }
    function selectedFormat(): string {
      return (container.querySelector<HTMLInputElement>('input[name="format"]:checked')?.value ?? 'json');
    }
    function rowCount(): number {
      return Math.min(1000, Math.max(1, parseInt(rowCountInput.value, 10) || 1));
    }

    function generateRows(count: number): Record<string, unknown>[] {
      const fields = selectedFields();
      return Array.from({ length: count }, () =>
        Object.fromEntries(fields.map((f) => [FIELD_LABELS[f] ?? f, generators[f]!()]))
      );
    }

    // ---------- Formatters ----------
    function toJson(rows: Record<string, unknown>[]): string {
      return JSON.stringify(rows, null, 2);
    }
    function csvEscape(v: unknown): string {
      const s = String(v ?? '');
      return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }
    function toCsv(rows: Record<string, unknown>[]): string {
      if (rows.length === 0) return '';
      const headers = Object.keys(rows[0]);
      const lines = [headers.map(csvEscape).join(',')];
      for (const row of rows) lines.push(headers.map((h) => csvEscape(row[h])).join(','));
      return lines.join('\n');
    }
    function sqlEscape(v: unknown): string {
      if (v === null || v === undefined) return 'NULL';
      if (typeof v === 'number') return String(v);
      if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
      return `'${String(v).replace(/'/g, "''")}'`;
    }
    function toSql(rows: Record<string, unknown>[], table: string): string {
      if (rows.length === 0) return '';
      const table_ = /^[A-Za-z_][A-Za-z0-9_]*$/.test(table) ? table : 'mock_data';
      const headers = Object.keys(rows[0]);
      const values = rows
        .map((r) => `  (${headers.map((h) => sqlEscape(r[h])).join(', ')})`)
        .join(',\n');
      return `INSERT INTO ${table_} (${headers.map((h) => `"${h}"`).join(', ')})\nVALUES\n${values};`;
    }

    function formatRows(rows: Record<string, unknown>[]): string {
      switch (selectedFormat()) {
        case 'csv': return toCsv(rows);
        case 'sql': return toSql(rows, tableNameInput.value.trim() || 'mock_data');
        default: return toJson(rows);
      }
    }

    // ---------- Live preview (signature moment) ----------
    function refreshPreview(): void {
      const fields = selectedFields();
      if (fields.length === 0) {
        previewEl.textContent = 'Select at least one field…';
        return;
      }
      previewEl.textContent = formatRows(generateRows(10));
    }

    container.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'field' || target.name === 'format') {
        tableNameWrap.classList.toggle('hidden', selectedFormat() !== 'sql');
      }
      refreshPreview();
    });
    rowCountInput.addEventListener('input', refreshPreview);
    tableNameInput.addEventListener('input', refreshPreview);
    refreshPreview();

    // ---------- Copy / Download ----------
    copyBtn.addEventListener('click', async () => {
      const text = formatRows(generateRows(rowCount()));
      try {
        await navigator.clipboard.writeText(text);
        copyBtn.textContent = 'Copied!';
      } catch {
        copyBtn.textContent = 'Copy failed';
      }
      setTimeout(() => (copyBtn.textContent = 'Copy'), 1500);
    });

    downloadBtn.addEventListener('click', () => {
      const format = selectedFormat();
      const text = formatRows(generateRows(rowCount()));
      const ext = format === 'json' ? 'json' : format;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
      a.download = `fake-data-${Date.now()}.${ext}`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Fake Data Generator',
    url: 'https://devtoolbench.dev/fake-data-generator',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Free fake data generator: create realistic mock data — names, emails, addresses, companies, UUIDs — exported as JSON, CSV, or SQL INSERT statements. Runs 100% in the browser.',
  })} />

  <aside class="related">
    <h2>More free tools from DevToolbench</h2>
    <ul>
      <li><a href="/breach-checker">Password breach checker — check if your email was hacked</a></li>
      <li><a href="/speed-test">Bulk website speed test — test multiple websites at once</a></li>
    </ul>
  </aside>

  <style>
    .related { max-width: 46rem; margin: 0 0 2rem; padding: 1rem 1.25rem; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 8px; }
    .related h2 { font-size: 1rem; margin: 0 0 0.5rem; }
    .related ul { margin: 0; padding-left: 1.25rem; font-size: 0.9375rem; }
    .related li { margin: 0.25rem 0; }

    .intro { padding: 2rem 0 0.5rem; }
    .intro h1 { margin: 0 0 0.5rem; font-size: 1.75rem; }
    .intro p { color: var(--text-dim); max-width: 44rem; margin: 0; }

    .tool {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.5rem;
      margin: 1.5rem 0;
    }
    .controls { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
    @media (min-width: 48rem) { .controls { grid-template-columns: 2fr 1fr; } }

    fieldset { border: 1px solid var(--border); border-radius: 8px; padding: 0.875rem 1rem 1rem; margin: 0; }
    legend { font-size: 0.8125rem; color: var(--text-dim); padding: 0 0.375rem; }
    .checkbox-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: 0.375rem; }
    .check { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; cursor: pointer; color: var(--text-dim); }
    .check:has(input:checked) { color: var(--text); }
    .check input { accent-color: var(--good); }
    .format-toggle { display: flex; gap: 1rem; flex-wrap: wrap; }

    .panel { display: flex; flex-direction: column; gap: 1rem; }
    .field-label { display: block; font-size: 0.875rem; margin-bottom: 0.375rem; color: var(--text-dim); }
    .panel input[type="number"], .panel input[type="text"] {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.5rem 0.75rem;
      color: var(--text);
      font-size: 0.9375rem;
    }
    .hidden { display: none; }
    .actions { display: flex; gap: 0.5rem; margin-top: auto; }
    .actions button {
      flex: 1;
      border: 1px solid var(--good);
      background: transparent;
      color: var(--good);
      border-radius: 6px;
      padding: 0.625rem 1rem;
      font-weight: 600;
      cursor: pointer;
    }
    .actions button.primary { background: var(--good); color: #04211d; }
    .actions button:hover { filter: brightness(1.1); }

    .preview-block { margin-top: 1.25rem; }
    .preview-label { font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.5rem; }
    #preview { max-height: 22rem; margin: 0; white-space: pre-wrap; word-break: break-word; }

    .explainer { max-width: 46rem; padding: 1rem 0 2rem; }
    .explainer h2 { font-size: 1.25rem; margin-top: 2rem; }
    .explainer p { color: var(--text-dim); font-size: 0.9375rem; }
    .faq details {
      background: var(--bg-raised);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      margin-top: 0.5rem;
    }
    .faq summary { font-weight: 600; }
    .faq summary::marker { color: var(--good); }
    .faq p { color: var(--text-dim); font-size: 0.9375rem; }
  </style>
</Layout>
